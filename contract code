from genlayer import *
import json
import typing

class BuilderProofVerifier(gl.Contract):

    owner: str
    total_submissions: u256
    submissions: TreeMap[str, str]
    verdicts: TreeMap[str, str]

    def __init__(self) -> None:
        self.owner = str(gl.message.sender_address)
        self.total_submissions = u256(0)
        self.submissions = TreeMap()
        self.verdicts = TreeMap()

    @gl.public.write
    def submit_proof(
        self,
        proof_id: str,
        github_url: str,
        demo_url: str,
        summary: str
    ) -> None:
        if not proof_id or not summary:
            raise Exception("proof_id and summary are required")

        submission = json.dumps({
            "proof_id": proof_id,
            "github_url": github_url,
            "demo_url": demo_url,
            "summary": summary,
            "submitter": str(gl.message.sender_address),
            "status": "PENDING"
        })
        self.submissions[proof_id] = submission
        self.total_submissions = u256(int(self.total_submissions) + 1)

    @gl.public.write
    def judge_proof(self, proof_id: str) -> None:
        submission_raw = self.submissions.get(proof_id, "")
        if not submission_raw:
            raise Exception("Submission not found")

        submission = json.loads(submission_raw)

        def evaluate() -> str:
            web_data = ""
            if submission.get("github_url"):
                response = gl.nondet.web.get(submission["github_url"])
                web_data = response.body.decode("utf-8")[:2000]

            prompt = f"""You are an impartial GenLayer validator reviewing a builder proof submission.

Task: Decide whether the submitted evidence shows genuine, meaningful work.

Summary provided by builder: {submission['summary']}

GitHub content (if available): {web_data[:1500]}

Rules:
- Return valid JSON only.
- Do not invent facts not present in the evidence.
- If evidence is unclear or insufficient, set verdict to NEEDS_MORE_EVIDENCE.
- Use one of: SHIPPED, WEAK, FAKE, NEEDS_MORE_EVIDENCE.
- Score must be an integer from 0 to 100.

Return this exact JSON schema:
{{
    "verdict": "SHIPPED | WEAK | FAKE | NEEDS_MORE_EVIDENCE",
    "score": 0,
    "evidence_quality": "LOW | MEDIUM | HIGH",
    "reasons": ["reason 1", "reason 2"],
    "risk_flags": ["flag 1"],
    "confidence": "LOW | MEDIUM | HIGH"
}}"""

            return gl.nondet.exec_prompt(prompt)

        result = gl.eq_principle.strict_eq(evaluate)

        verdict = json.dumps({
            "proof_id": proof_id,
            "verdict_raw": result,
            "judged": True
        })
        self.verdicts[proof_id] = verdict

    @gl.public.view
    def get_submission(self, proof_id: str) -> str:
        return self.submissions.get(proof_id, "")

    @gl.public.view
    def get_verdict(self, proof_id: str) -> str:
        return self.verdicts.get(proof_id, "")

    @gl.public.view
    def get_total(self) -> u256:
        return self.total_submissions

    @gl.public.view
    def get_owner(self) -> str:
        return self.owner
